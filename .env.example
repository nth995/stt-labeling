# STT LABELING - ENVIRONMENT CONFIGURATION

# UID/GID của tài khoản sở hữu thư mục data/ và state/
APP_UID=1000
APP_GID=1000

# Cấu hình Web Server
APP_BIND_IP=0.0.0.0
APP_PORT=8000

# Khóa bí mật dùng cho phiên đăng nhập
# Phải dài tối thiểu 32 ký tự
SESSION_SECRET=

# false khi truy cập HTTP trong mạng LAN
COOKIE_SECURE=false

# Đường dẫn dữ liệu bên trong Docker
DATA_DIR=/app/data
STATE_DIR=/app/state